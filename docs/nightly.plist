<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON3__</string><string>-m</string><string>engine.nightly</string>
    <string>--site</string><string>__SITE__</string><string>--live</string>
  </array>
  <key>WorkingDirectory</key><string>__REPOSITORY__</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>__DATA_DIRECTORY__/nightly.stdout.log</string>
  <key>StandardErrorPath</key><string>__DATA_DIRECTORY__/nightly.stderr.log</string>
  <key>ProcessType</key><string>Background</string>
</dict></plist>
